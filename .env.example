# Copy to .env (git-ignored) and fill in. Never commit .env.

# Monad testnet (chain ID 10143). Re-check live values before relying on them.
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# Relayer: pays gas only. Testnet MON only. Never log this value.
RELAYER_PRIVATE_KEY=

# Deployed Votalo contract address (filled after Phase 2)
NEXT_PUBLIC_VOTALO_ADDRESS=

# Passkey relying party id. Leave empty to use the current hostname (localhost in dev, the *.vercel.app
# preview host on preview deploys). Production uses the registrable domain, votalo.xyz, so passkeys work on
# both votalo.xyz and www.votalo.xyz. Passkeys are bound to this id; a *.vercel.app origin cannot use it.
NEXT_PUBLIC_RP_ID=

# Canonical site URL, used for metadata (og:url, og:image) and for share links and embed snippets.
# Production: https://www.votalo.xyz. Empty in local development (falls back to the current origin).
NEXT_PUBLIC_SITE_URL=

# Hosted Envio GraphQL endpoint. Server-only: the browser must never call Envio directly, since
# the free plan caps it at 100 queries/minute total, shared across every visitor. The app's own
# /api/data/* routes proxy and cache the queries in docs/FRONTEND.md against this.
ENVIO_GRAPHQL_URL=

# Vercel Blob read-write token for the encrypted group vault (/api/vault/:vaultId). Auto-set by
# Vercel when a Blob store is linked to this project; set manually only for local development.
# The server stores only { iv, ciphertext } here — never plaintext, a PRF output, or a key.
BLOB_READ_WRITE_TOKEN=
